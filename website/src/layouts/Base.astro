---
/**
 * The shell every page renders into: fonts, tokens, metadata, header and footer.
 *
 * Fonts are imported here rather than linked, so the site fetches nothing from a third party at
 * runtime — the same reason the inspector reads files locally. Canonical and Open Graph URLs are
 * derived from `Astro.site`, which Vercel supplies from the deployment origin, so no absolute URL
 * is written down anywhere and none can point at the wrong domain.
 */
import '@fontsource-variable/archivo/standard.css';
import '@fontsource-variable/newsreader/wght.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/tokens.css';
import Analytics from '@vercel/analytics/astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

interface Props {
  title: string;
  description: string;
  /** The landing page runs its hero full-bleed and supplies its own top spacing. */
  wide?: boolean;
  /** Path to this page's raw-markdown twin, when it has one. */
  markdownPath?: string;
  /**
   * Schema.org JSON-LD for this page, already shaped. Pages own their structured data because
   * only the page knows what it IS — the layout cannot guess a TechArticle from a title. The
   * one rule: everything in it must restate what is visible on the page, never more. Structured
   * data that contradicts the page ("schema drift") reads as spam to the crawlers it exists for.
   */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, wide = false, markdownPath, schema } = Astro.props;
/*
 * The home page carries the query someone actually types ("read EEG files JavaScript"), since
 * "edfcore" alone is a title only people who already found it would search for. Every other page
 * keeps `Page | edfcore`, the specific half first.
 *
 * A pipe rather than an em dash: the title is the one string that shows up truncated in a browser
 * tab, a search result and a share preview, and a pipe reads as a separator at any width.
 */
const fullTitle =
  title === 'edfcore'
    ? 'edfcore: read EEG and biosignal files in JavaScript and TypeScript'
    : `${title} | edfcore`;

// Astro.site comes from the deployment origin, so these are correct without configuration.
const canonical = Astro.site
  ? new URL(Astro.url.pathname, Astro.site).href
  : Astro.url.pathname;
const markdownHref =
  markdownPath && Astro.site ? new URL(markdownPath, Astro.site).href : markdownPath;
/*
 * The share card. One static image for every page: per-page cards earn their keep on sites
 * where pages are shared apart from the brand (a blog); a library's docs pages all share as
 * "edfcore", and one hand-made card beats twenty generated ones. Absolute URL, because the
 * scrapers that read og:image do not resolve relative ones.
 */
const ogImage = Astro.site ? new URL('/og.png', Astro.site).href : '/og.png';
const ogImageAlt =
  'edfcore — a phosphor-green signal trace with a labelled sleep-stage annotation, ' +
  'over the line: read EDF, EDF+ and BDF biosignal files in TypeScript';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="edfcore" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#14120e" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f6f2e8" />
    {
      /* Serialized here rather than in the pages so no page can forget the script type.
         JSON.stringify never emits a bare `</script>` from our own string data — the one
         character that could break out is escaped by the `<` never appearing unescaped in
         schema values, all of which are titles and URLs this site already renders. */
      schema && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}
        />
      )
    }
    {
      /* Retrieval crawlers do not use HTTP content negotiation, but the ones that fetch
         markdown at all find it through a link like this. */
      markdownHref && (
        <link rel="alternate" type="text/markdown" href={markdownHref} title="Markdown" />
      )
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      /*
       * Analytics filter. Must be defined before the analytics component's module script
       * upgrades its custom element, which is why it is inline and in the head.
       *
       * This site tells people their recordings never leave the machine, so the measurement
       * on it should be able to withstand someone reading the network tab. Vercel Analytics
       * is cookieless and records a path, not a person, and no page here takes a query
       * string today. This strips the query and hash anyway: it costs nothing, and it means
       * a future page that does take a parameter cannot start leaking one by accident.
       */
      window.webAnalyticsBeforeSend = (event) => {
        try {
          const url = new URL(event.url, window.location.origin);
          return { ...event, url: url.origin + url.pathname };
        } catch {
          return event;
        }
      };
    </script>
    <script is:inline>
      // Runs before first paint so the chosen theme never flashes the other one.
      (() => {
        try {
          const saved = localStorage.getItem('edfcore-theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.dataset.theme = saved;
          }
        } catch {
          /* Private mode blocks storage; the media query is a fine fallback. */
        }
      })();
    </script>
  </head>
  <body class={wide ? 'is-wide' : ''}>
    <a class="skip" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <Analytics />
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: var(--s-4);
    top: -4rem;
    z-index: 100;
    padding: var(--s-2) var(--s-4);
    background: var(--accent);
    color: var(--accent-ink);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: var(--t-sm);
    text-decoration: none;
    transition: top 160ms ease;
  }

  .skip:focus {
    top: var(--s-4);
  }

  main {
    min-height: 60vh;
  }
</style>
