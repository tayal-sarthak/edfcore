---
/**
 * The site header, with exactly one link marked current.
 *
 * Two destinations and a longest-prefix match, which is more than it looks: `/docs` and `/demo`
 * do not overlap today, and a plain `startsWith` over an unordered list would light two links at
 * once the first time they do. Marking the most specific match is the rule that survives a third
 * destination being added.
 */
const path = Astro.url.pathname;

const links = [
  { href: '/docs/quick-start', label: 'Docs', match: '/docs' },
  { href: '/demo', label: 'Inspector', match: '/demo' },
];

// Longest matching prefix wins, so a more specific link never lights up a broader one too.
const best = links
  .filter((link) => path.startsWith(link.match))
  .sort((a, b) => b.match.length - a.match.length)[0];
const isActive = (link: (typeof links)[number]) => link === best;
---

<header class="site-header">
  <div class="page bar">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 28 16" fill="none" stroke="currentColor" stroke-width="1.6">
          <path
            d="M0 8h4l2-5 2.5 10L11 4l2 6 1.5-3H18"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
          <path d="M20 3v10M24 5v6M27.2 7v2" stroke-linecap="round" opacity="0.45"></path>
        </svg>
      </span>
      <span class="brand-word">edfcore</span>
    </a>

    <nav aria-label="Main">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href} aria-current={isActive(link) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="tail">
      <a
        class="ghost"
        href="https://github.com/tayal-sarthak/edfcore"
        rel="noopener"
        aria-label="edfcore on GitHub"
      >
        <svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
      </a>
      <button
        class="ghost"
        id="theme-toggle"
        type="button"
        aria-label="Switch between the dark and light theme"
      >
        <svg class="sun" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
          <circle cx="8" cy="8" r="3.2" fill="currentColor"></circle>
          <g stroke="currentColor" stroke-width="1.4" stroke-linecap="round">
            <path d="M8 .8v2M8 13.2v2M.8 8h2M13.2 8h2M2.9 2.9l1.4 1.4M11.7 11.7l1.4 1.4M13.1 2.9l-1.4 1.4M4.3 11.7l-1.4 1.4"
            ></path>
          </g>
        </svg>
        <svg class="moon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
          <path
            d="M13.5 9.6A5.8 5.8 0 0 1 6.4 2.5a5.9 5.9 0 1 0 7.1 7.1Z"
            fill="currentColor"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<script>
  const root = document.documentElement;
  const toggle = document.getElementById('theme-toggle');

  toggle?.addEventListener('click', () => {
    const current =
      root.dataset.theme ??
      (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('edfcore-theme', next);
    } catch {
      /* Storage is optional; the toggle still works for this page view. */
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--bg) 88%, transparent);
    backdrop-filter: blur(12px) saturate(1.2);
    border-bottom: 1px solid var(--rule-soft);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--s-6);
    height: 3.75rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    color: var(--text);
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 660;
    font-stretch: 116%;
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
  }

  .brand-mark {
    display: block;
    width: 28px;
    color: var(--accent);
  }

  .brand-mark svg {
    width: 28px;
    height: 16px;
    overflow: visible;
  }

  .brand-word {
    /* The name is set tight so the trace mark reads as part of the wordmark. */
    letter-spacing: -0.02em;
  }

  nav {
    margin-inline-start: auto;
  }

  nav ul {
    display: flex;
    align-items: center;
    gap: var(--s-5);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  nav a {
    font-family: var(--font-mono);
    font-size: var(--t-sm);
    letter-spacing: 0.01em;
    color: var(--text-dim);
    text-decoration: none;
    padding-block: var(--s-2);
    border-bottom: 1px solid transparent;
  }

  nav a:hover {
    color: var(--text);
  }

  nav a[aria-current='page'] {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  .tail {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }

  .ghost {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: none;
    color: var(--text-muted);
    cursor: pointer;
    transition: color 140ms ease, border-color 140ms ease, background 140ms ease;
  }

  .ghost:hover {
    color: var(--text);
    border-color: var(--rule);
    background: var(--bg-raised);
  }

  /*
   * The button shows the theme you would switch TO, so a sun means "go light".
   * Dark is the default world, hence sun-by-default; the light media query flips it, and an
   * explicit data-theme must win over that query in both directions.
   */
  .sun {
    display: block;
  }

  .moon {
    display: none;
  }

  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme])) .sun {
      display: none;
    }
    :global(:root:not([data-theme])) .moon {
      display: block;
    }
  }

  :global(:root[data-theme='light']) .sun {
    display: none;
  }

  :global(:root[data-theme='light']) .moon {
    display: block;
  }

  :global(:root[data-theme='dark']) .sun {
    display: block;
  }

  :global(:root[data-theme='dark']) .moon {
    display: none;
  }

  @media (max-width: 640px) {
    .bar {
      gap: var(--s-4);
    }
    nav ul {
      gap: var(--s-4);
    }
  }
</style>
