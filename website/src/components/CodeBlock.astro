---
/**
 * A highlighted snippet with an optional caption.
 *
 * Highlighting happens at build time through Shiki, so no syntax highlighter ships to the
 * browser — a documentation site should not cost a reader a parser to render text that never
 * changes. The single dark theme is deliberate and explained in `astro.config.mjs`.
 */
import { Code } from 'astro:components';

interface Props {
  code: string;
  lang?: 'ts' | 'js' | 'bash' | 'json' | 'text';
  /** A short label above the block. Say what the snippet does, not "example". */
  caption?: string;
}

const { code, lang = 'ts', caption } = Astro.props;
---

<figure class="block">
  {
    caption && (
      <figcaption>
        <span class="eyebrow">{caption}</span>
        {/* No aria-label: it would replace the text that says "copied" with one that never changes. */}
        <button class="copy" type="button" data-code={code} aria-live="polite">
          copy
        </button>
      </figcaption>
    )
  }
  <Code code={code} lang={lang} />
</figure>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy').forEach((button) => {
    let reset: number | undefined;
    button.addEventListener('click', async () => {
      const code = button.dataset.code;
      if (!code) return;
      try {
        await navigator.clipboard.writeText(code);
        button.textContent = 'copied';
      } catch {
        // Clipboard access can be refused; say so rather than silently doing nothing. Selected
        // first, so the visitor's own copy has something to take — and no key named, because ⌘C
        // is wrong off a Mac and there is no keyboard at all on a phone.
        const pre = button.closest('figure')?.querySelector('pre');
        if (pre) window.getSelection()?.selectAllChildren(pre);
        button.textContent = 'copy the selection';
      }
      // Restarted on every click: the first click's timer would otherwise cut the second's short.
      window.clearTimeout(reset);
      reset = window.setTimeout(() => {
        button.textContent = 'copy';
      }, 1600);
    });
  });
</script>

<style>
  .block {
    margin: 0;
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    background: var(--bg-sunken);
    overflow: hidden;
  }

  figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding: var(--s-3) var(--s-4);
    border-bottom: 1px solid var(--rule-soft);
    background: var(--bg-inset);
  }

  .copy {
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: none;
    padding: 0.15rem var(--s-2);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    cursor: pointer;
    transition: color 140ms ease, border-color 140ms ease;
  }

  .copy:hover {
    color: var(--accent);
    border-color: var(--rule);
  }

  /* The block owns the frame, so the inner <pre> drops its own. */
  .block :global(pre) {
    border: 0;
    border-radius: 0;
    margin: 0;
  }
</style>
