---
/**
 * The hero figure: a single EEG trace drawn across the page.
 *
 * The samples are real. A deterministic signal is generated, encoded to little-endian 16-bit
 * two's complement exactly as EDF stores it, and then decoded back out through the same
 * arithmetic the library uses — so the line on screen is the output of the thing being sold,
 * not a drawing of one.
 *
 * An earlier version showed the underlying bytes as a hex grid behind the trace. It made the
 * point but read as noise, so the bytes are still what drives the curve and are simply no
 * longer painted.
 */
interface Props {
  height?: number;
}
const { height = 260 } = Astro.props;
---

<figure class="strip" style={`--strip-h:${height}px`}>
  <canvas id="trace-strip" aria-hidden="true"></canvas>
  <figcaption class="visually-hidden">
    An electroencephalogram trace, drawn from sample values decoded by edfcore.
  </figcaption>
</figure>

<script>
  import { animate } from 'motion';

  const canvas = document.getElementById('trace-strip') as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext('2d');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ---- the signal, and the bytes that hold it -------------------------------
    const SAMPLES = 1400;
    const digital = new Int16Array(SAMPLES);
    for (let i = 0; i < SAMPLES; i += 1) {
      const t = i / 64;
      // Deliberately slow: about eight waves across the strip rather than twenty. A denser
      // trace is more literally EEG-like and reads as a scribble at this size.
      const alpha = Math.sin(t * 2.3) * 900;
      const theta = Math.sin(t * 0.9 + 1.1) * 380;
      const drift = Math.sin(t * 0.21) * 260;
      const spike = i > 660 && i < 760 ? Math.sin(((i - 660) / 100) * Math.PI) * 1900 : 0;
      // Just enough deterministic wobble that the line reads as measured, not drawn.
      const wobble = Math.sin(i * 0.7639320225) * 55;
      digital[i] = Math.max(
        -32768,
        Math.min(32767, Math.round(alpha + theta + drift + spike + wobble)),
      );
    }

    // Round-tripped through the on-disk encoding, so the curve is genuinely decoded output.
    const bytes = new Uint8Array(SAMPLES * 2);
    for (let i = 0; i < SAMPLES; i += 1) {
      const v = (digital[i] ?? 0) < 0 ? (digital[i] ?? 0) + 0x10000 : (digital[i] ?? 0);
      bytes[i * 2] = v & 0xff;
      bytes[i * 2 + 1] = (v >> 8) & 0xff;
    }
    const decoded = new Int32Array(SAMPLES);
    for (let i = 0; i < SAMPLES; i += 1) {
      const raw = (bytes[i * 2] ?? 0) | ((bytes[i * 2 + 1] ?? 0) << 8);
      decoded[i] = raw & 0x8000 ? raw - 0x10000 : raw;
    }
    const peak = decoded.reduce((m, v) => Math.max(m, Math.abs(v)), 1);

    const readTokens = () => {
      const s = getComputedStyle(document.documentElement);
      return {
        trace: s.getPropertyValue('--accent').trim(),
        rule: s.getPropertyValue('--rule-soft').trim(),
      };
    };
    let tokens = readTokens();

    let width = 0;
    let cssHeight = 0;
    let progress = 0;

    const resize = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      const rect = canvas.getBoundingClientRect();
      width = rect.width;
      cssHeight = rect.height;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(cssHeight * dpr);
      ctx?.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const draw = () => {
      if (!ctx) return;
      ctx.clearRect(0, 0, width, cssHeight);

      const mid = cssHeight / 2;
      const amp = cssHeight * 0.34;

      // A single hairline baseline. The trace is the only other mark on the strip.
      ctx.strokeStyle = tokens.rule;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(0, mid);
      ctx.lineTo(width, mid);
      ctx.stroke();

      const visible = Math.max(2, Math.floor(progress * SAMPLES));
      ctx.beginPath();
      for (let i = 0; i < visible; i += 1) {
        const x = (i / (SAMPLES - 1)) * width;
        const y = mid - ((decoded[i] ?? 0) / peak) * amp;
        if (i === 0) ctx.moveTo(x, y);
        else ctx.lineTo(x, y);
      }
      ctx.strokeStyle = tokens.trace;
      ctx.lineWidth = 1.75;
      ctx.lineJoin = 'round';
      ctx.lineCap = 'round';
      ctx.stroke();
    };

    resize();

    if (reduced) {
      progress = 1;
      draw();
    } else {
      animate(0, 1, {
        duration: 2.2,
        ease: [0.22, 0.61, 0.24, 1],
        onUpdate: (p: number) => {
          progress = p;
          draw();
        },
      });
    }

    let frame = 0;
    window.addEventListener('resize', () => {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(() => {
        resize();
        draw();
      });
    });

    // The canvas paints from CSS custom properties, so it repaints when the theme changes.
    new MutationObserver(() => {
      tokens = readTokens();
      draw();
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
  }
</script>

<style>
  .strip {
    position: relative;
    margin: 0;
    height: var(--strip-h);
    border-top: 1px solid var(--rule-soft);
    border-bottom: 1px solid var(--rule-soft);
    background: var(--bg-sunken);
    overflow: hidden;
  }

  canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  @media (max-width: 640px) {
    .strip {
      height: 170px;
    }
  }
</style>
