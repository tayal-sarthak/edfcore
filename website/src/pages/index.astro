---
/**
 * The landing page.
 *
 * Its code samples are written out here as strings rather than imported from the docs, and that
 * is the one thing to know before editing them: nothing checks that they still compile. Anything
 * a reader might copy belongs on a docs page, where `tests/types` typechecks the documented
 * examples — this page shows shape, not recipes.
 */
import { VERSION } from 'edfcore';
import Base from '../layouts/Base.astro';
import TraceStrip from '../components/TraceStrip.astro';
import CodeBlock from '../components/CodeBlock.astro';

const description =
  'A typed, dependency-free TypeScript reader for EDF, EDF+, BDF and BDF+ biosignal files. ' +
  'Real random access, exact event times, and errors that name the byte.';

/*
 * SoftwareSourceCode, deliberately not SoftwareApplication. Google's software-app rich result
 * requires a rating or review, which this library does not have — inventing one to qualify is
 * the exact "schema drift" that costs a site its credibility with the crawlers this block is
 * for. A source-code entity needs nothing invented: every property below restates something
 * already visible on this page or on the repo, and its job in 2026 is disambiguation — telling
 * search and answer engines what "edfcore" IS — rather than winning a rich result.
 */
const site = Astro.site?.href ?? 'https://edfcore.vercel.app/';
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site}#website`,
      url: site,
      name: 'edfcore',
      description,
    },
    {
      '@type': 'SoftwareSourceCode',
      '@id': `${site}#software`,
      name: 'edfcore',
      description,
      url: site,
      codeRepository: 'https://github.com/tayal-sarthak/edfcore',
      programmingLanguage: 'TypeScript',
      runtimePlatform: ['Web browser', 'Node.js', 'Deno', 'Bun'],
      license: 'https://opensource.org/license/mit',
      version: VERSION,
      author: { '@type': 'Person', name: 'Sarthak Tayal', url: 'https://github.com/tayal-sarthak' },
      keywords:
        'EDF, EDF+, BDF, BDF+, European Data Format, EEG, ECG, polysomnography, sleep study, biosignal',
      sameAs: ['https://www.npmjs.com/package/edfcore'],
    },
  ],
};

const readExample = `import { openEdf, blobSource, getSignal, readWindow, toPhysical } from 'edfcore';

const recording = await openEdf(blobSource(file));
const fp1 = getSignal(recording.header, 'Fp1');

const [chunk] = await readWindow(recording, {
  signalIndices: [fp1.index],
  startSeconds: 30,
  durationSeconds: 10,
});

const microvolts = toPhysical(fp1, chunk.signals[0].digital);`;

const diagnosticExample = `const recording = await openEdf(source);

for (const problem of recording.header.diagnostics) {
  console.log(problem.code, problem.byteOffset, problem.message);
}
// DEGENERATE_DIGITAL_RANGE 3400 signal 7 "EMG Chin" declares digitalMinimum ===
//   digitalMaximum === 0, so physical scale is undefined (division by zero). …`;

const gapExample = `// A discontinuous recording is a list of runs, never one continuous block.
const chunks = await readWindow(recording, {
  signalIndices: [0],
  startSeconds: 0,
  durationSeconds: 7200,
});

chunks.length;                    // one chunk per contiguous run
chunks[1].precededByGap;          // EdfGap — where the recorder stopped
`;

// Surveyed across every EDF package on npm in mid-2026. Figures drift; the shape does not.
const gaps = [
  ['Ships TypeScript types', 'No standalone reader does'],
  ['Random access to a time window', 'Nothing published — the file is loaded whole'],
  ['BDF / 24-bit samples', 'No published package can read them'],
  ['Discontinuous EDF+D', 'Rejected, or silently decoded as contiguous'],
  ['Typed, located errors', 'console.warn and null, or bare thrown strings'],
  ['Header validation', 'Essentially none'],
];
---

<Base title="edfcore" description={description} schema={schema} wide>
  <section class="hero">
    <div class="page">
      <h1 class="reveal">Read EDF files<br />in JavaScript.</h1>
      <p class="lede reveal">
        Read EEG and biosignal files directly in JavaScript and TypeScript. Supports EDF, EDF+,
        BDF and BDF+, in the browser and in Node.
      </p>

      <div class="actions reveal">
        <code class="install" id="install"
          ><span class="prompt" aria-hidden="true">$</span> npm install edfcore</code
        >
        <a class="btn btn-primary" href="/docs/quick-start">Quick start</a>
        <a class="btn" href="/demo">Open the inspector</a>
      </div>

      <p class="note reveal">Zero dependencies. TypeScript types included. MIT licensed.</p>
    </div>
  </section>

  <TraceStrip />

  <section class="band">
    <div class="page split">
      <div>
        <h2>Ten seconds out of twelve hours reads ten seconds of bytes.</h2>
        <p class="measure">
          An EDF file stores every channel interleaved inside fixed-size data records, so a
          time window maps to a contiguous run of records. edfcore reads exactly that run.
          Opening a file reads the header and nothing else. It doesn't scan.
        </p>
      </div>
      <CodeBlock code={readExample} lang="ts" caption="Reading a window in the browser" />
    </div>
  </section>

  <section class="band band-inset">
    <div class="page">
      <h2>Python has the tooling for EDF. JavaScript didn't.</h2>
      <p class="measure lede-2">
        This is every EDF package on npm, surveyed in mid-2026:
      </p>

      <div class="scroll-x">
        <table class="gaps">
          <thead>
            <tr><th scope="col">Capability</th><th scope="col">Before edfcore</th></tr>
          </thead>
          <tbody>
            {
              gaps.map(([capability, state]) => (
                <tr>
                  <th scope="row">{capability}</th>
                  <td>{state}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="measure aside">
        The strongest prior art is <a
          href="https://github.com/epicurrents/edf-reader"
          rel="noopener">@epicurrents/edf-reader</a
        >, worth using if you want a whole viewer framework.
        <a href="/docs/comparison">See the full comparison.</a>
      </p>
    </div>
  </section>

  <section class="band">
    <div class="page split split-reverse">
      <div>
        <h2>A bad file either throws or reports itself.</h2>
        <p class="measure">
          One rule decides which. If edfcore can't continue without inventing something, it
          throws. If it can continue on what the file says, it records a diagnostic on the
          result. There's no third option, and nothing is written to the console.
        </p>
        <p class="measure">
          A header that declares <code>digitalMinimum === digitalMaximum</code> defines no
          scale: the gain is a division by zero. edfcore sets <code>signal.scale</code> to
          <code>undefined</code>, so reading the gain without checking is a compile error and
          <code>toPhysical</code> throws at runtime. EDFlib substitutes a
          gain of 1 here and returns ADC counts labelled as microvolts.
        </p>
      </div>
      <CodeBlock
        code={diagnosticExample}
        lang="ts"
        caption="Diagnostics on the result"
      />
    </div>
  </section>

  <section class="band band-inset">
    <div class="page split">
      <div>
        <h2>Discontinuous recordings.</h2>
        <p class="measure">
          Sleep and long-term-monitoring studies are routinely discontinuous. Most readers
          either reject those files or decode them as though the gaps weren't there, producing
          a timeline that's wrong by hours.
        </p>
        <p class="measure">
          <code>readWindow</code> always returns an array of chunks, one per contiguous run,
          including for continuous files. A window inside a gap returns an empty array.
        </p>
      </div>
      <CodeBlock code={gapExample} lang="ts" caption="Reading a discontinuous file" />
    </div>
  </section>

  <section class="band closing">
    <div class="page">
      <h2>Try it on your own file.</h2>
      <p class="measure">
        The inspector runs in your browser. Nothing is uploaded, because there's no server to
        upload to. That's the same reason edfcore suits clinical and research data.
      </p>
      <div class="actions">
        <a class="btn btn-primary" href="/demo">Open the inspector</a>
        <a class="btn" href="/docs/concepts">Read the concepts</a>
      </div>
    </div>
  </section>
</Base>



<style>
  /*
   * One entrance, on the hero alone, in CSS alone. The previous version fade-slid every
   * heading and paragraph on the page as it scrolled into view — the scroll-reveal-everything
   * pattern that reads as templated precisely because every generated site ships it. Content
   * below the fold now simply is there, which is what a reader scrolling for information
   * wants from it. An animation cannot strand the page invisible when its script never runs,
   * because there is no script; reduced-motion is already handled globally in tokens.css.
   */
  .hero .reveal {
    animation: rise 600ms cubic-bezier(0.22, 0.61, 0.24, 1) both;
  }

  .hero .reveal:nth-child(2) {
    animation-delay: 70ms;
  }

  .hero .reveal:nth-child(3) {
    animation-delay: 140ms;
  }

  .hero .reveal:nth-child(4) {
    animation-delay: 190ms;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero {
    padding-block: clamp(3.5rem, 9vw, 7rem) var(--s-8);
  }

  h1 {
    margin-top: var(--s-4);
  }

  .lede {
    margin-top: var(--s-5);
    max-width: 54ch;
    font-size: var(--t-md);
    color: var(--text-dim);
  }

  .lede-2 {
    margin-top: var(--s-4);
    color: var(--text-dim);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }

  .install {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    padding: 0.6rem var(--s-4);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--bg-inset);
    color: var(--text);
    font-size: var(--t-sm);
    white-space: nowrap;
  }

  .prompt {
    color: var(--accent);
    user-select: none;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    padding: 0.6rem var(--s-5);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: var(--t-sm);
    text-decoration: none;
    transition: border-color 140ms ease, background 140ms ease, color 140ms ease;
  }

  .btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .btn-primary {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
    font-weight: 500;
  }

  .btn-primary:hover {
    background: var(--accent-hover);
    border-color: var(--accent-hover);
    color: var(--accent-ink);
  }

  .note {
    margin-top: var(--s-5);
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    color: var(--text-muted);
  }

  .band {
    padding-block: var(--s-8);
  }

  .band-inset {
    background: var(--bg-sunken);
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: var(--s-7);
    align-items: start;
  }

  .split-reverse > :first-child {
    order: 2;
  }

  .split p {
    margin-top: var(--s-4);
    color: var(--text-dim);
  }

  .gaps {
    width: 100%;
    margin-top: var(--s-5);
    border-collapse: collapse;
    font-size: var(--t-sm);
    text-align: left;
  }

  .gaps th,
  .gaps td {
    padding: var(--s-3) var(--s-4);
    border-bottom: 1px solid var(--rule-soft);
    vertical-align: top;
  }

  .gaps thead th {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    border-bottom-color: var(--rule);
  }

  .gaps tbody th {
    font-family: var(--font-body);
    font-weight: 600;
    color: var(--text);
    width: 34%;
  }

  .gaps td {
    color: var(--text-dim);
  }

  .aside {
    margin-top: var(--s-5);
    font-size: var(--t-sm);
    color: var(--text-muted);
  }

  .closing {
    text-align: left;
  }

  .closing p {
    margin-top: var(--s-4);
    color: var(--text-dim);
  }

  @media (max-width: 860px) {
    .split {
      grid-template-columns: 1fr;
      gap: var(--s-5);
    }
    .split-reverse > :first-child {
      order: 0;
    }
  }
</style>
