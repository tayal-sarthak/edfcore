---
/**
 * Every documentation page, from the one collection.
 *
 * The route is generated rather than enumerated, so adding a markdown file under
 * `content/docs/` publishes it — and the same collection feeds the nav, the outline and the
 * `llms.txt` endpoints. That is why the schema is strict about `section` and `order`: a page
 * missing either would render here and be absent from every map of the site.
 */
import { getCollection, render } from 'astro:content';
import DocsNav from '../../components/DocsNav.astro';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const docs = await getCollection('docs');
  return docs.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

// Only h2 and h3 belong in a page outline; anything deeper is detail inside a section.
const outline = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

<Base
  title={entry.data.title}
  description={entry.data.description}
  markdownPath={`/docs/${entry.id}.md`}
>
  <div class="page shell">
    <aside class="rail">
      <DocsNav current={entry.id} />
    </aside>

    <article class="doc">
      <header>
        <h1>{entry.data.title}</h1>
        <p class="lead">{entry.data.lead ?? entry.data.description}</p>
      </header>
      <div class="prose">
        <Content />
      </div>
    </article>

    {
      outline.length >= 4 && (
        <aside class="outline">
          <p class="eyebrow">On this page</p>
          <ul>
            {outline.map((heading) => (
              <li class={heading.depth === 3 ? 'sub' : ''}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }
  </div>
</Base>

<style>
  .shell {
    display: grid;
    grid-template-columns: 15rem minmax(0, 1fr) 13rem;
    gap: var(--s-7);
    align-items: start;
    padding-block: var(--s-7) var(--s-8);
  }

  .rail,
  .outline {
    position: sticky;
    top: 5.25rem;
    max-height: calc(100vh - 7rem);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .doc header {
    padding-bottom: var(--s-5);
    border-bottom: 1px solid var(--rule-soft);
  }

  .doc h1 {
    margin-top: var(--s-3);
    font-size: clamp(2.1rem, 4.5vw, 3rem);
  }

  .lead {
    margin-top: var(--s-4);
    max-width: var(--measure);
    font-size: var(--t-md);
    color: var(--text-dim);
  }

  .outline ul {
    list-style: none;
    margin: var(--s-3) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .outline a {
    font-size: var(--t-xs);
    line-height: 1.5;
    color: var(--text-muted);
    text-decoration: none;
  }

  .outline a:hover {
    color: var(--accent);
  }

  .outline .sub a {
    padding-left: var(--s-3);
  }

  @media (max-width: 1180px) {
    .shell {
      grid-template-columns: 14rem minmax(0, 1fr);
    }
    .outline {
      display: none;
    }
  }

  @media (max-width: 860px) {
    .shell {
      grid-template-columns: 1fr;
      gap: var(--s-6);
    }
    .rail {
      position: static;
      max-height: none;
      padding-bottom: var(--s-5);
      border-bottom: 1px solid var(--rule-soft);
    }
  }
</style>

<style is:global>
  /* Prose styles apply to markdown output, which is why they are global rather than scoped. */
  .prose {
    max-width: var(--measure);
    padding-top: var(--s-6);
  }

  .prose > * + * {
    margin-top: var(--s-4);
  }

  .prose h2 {
    margin-top: var(--s-7);
    font-size: var(--t-xl);
    scroll-margin-top: 5.5rem;
  }

  .prose h3 {
    margin-top: var(--s-6);
    font-size: var(--t-lg);
    scroll-margin-top: 5.5rem;
  }

  .prose h4 {
    margin-top: var(--s-5);
    font-size: var(--t-md);
    scroll-margin-top: 5.5rem;
  }

  .prose h2 + *,
  .prose h3 + *,
  .prose h4 + * {
    margin-top: var(--s-3);
  }

  .prose ul,
  .prose ol {
    padding-left: var(--s-5);
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
  }

  .prose li::marker {
    color: var(--text-muted);
  }

  .prose pre {
    /* Code is wider than the reading measure on purpose; prose stays at 66ch. */
    width: min(100%, 46rem);
  }

  .prose blockquote {
    padding: var(--s-4) var(--s-5);
    border: 1px solid var(--rule);
    border-left: 2px solid var(--accent);
    border-radius: var(--radius);
    background: var(--bg-raised);
    color: var(--text-dim);
  }

  .prose blockquote > * + * {
    margin-top: var(--s-3);
  }

  .prose blockquote strong:first-child {
    color: var(--text);
  }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--t-sm);
    text-align: left;
    font-variant-numeric: tabular-nums;
  }

  /* A table can be wider than the measure; it scrolls in its own box so the page never does. */
  .prose > table {
    display: block;
    overflow-x: auto;
    max-width: min(100%, 46rem);
    white-space: nowrap;
  }

  .prose th,
  .prose td {
    padding: var(--s-2) var(--s-3);
    border-bottom: 1px solid var(--rule-soft);
    vertical-align: top;
  }

  .prose thead th {
    font-family: var(--font-mono);
    font-size: var(--t-xs);
    font-weight: 500;
    color: var(--text-muted);
    border-bottom-color: var(--rule);
    white-space: nowrap;
  }

  .prose hr {
    border: 0;
    border-top: 1px solid var(--rule-soft);
    margin-block: var(--s-6);
  }
</style>
