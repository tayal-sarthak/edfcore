---
import Base from '../layouts/Base.astro';
---

<Base
  title="Inspector"
  description="Open an EDF, EDF+, BDF or BDF+ file and read its header, channels, events and waveforms — entirely in your browser, with nothing uploaded."
>
  <section class="page intro">
    <h1>Open a recording.</h1>
    <p class="lead">
      Nothing is uploaded. edfcore parses the file in this tab, which is the same reason it
      is usable for clinical and research data at all.
    </p>
  </section>

  <section class="page">
    <div class="dropzone" id="dropzone">
      <input type="file" id="file-input" accept=".edf,.EDF,.bdf,.BDF,.rec,.REC" hidden />
      <div class="dz-inner">
        <svg viewBox="0 0 40 22" class="dz-trace" aria-hidden="true">
          <path
            d="M0 11h6l3-7 3.5 14L17 6l2.5 9 2-5H40"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>
        <p class="dz-title">Drop an EDF or BDF file here</p>
        <p class="dz-sub">
          <button class="link-btn" type="button" id="browse">choose a file</button>
          <span aria-hidden="true"> &middot; </span>
          <button class="link-btn" type="button" id="sample">or load a sample recording</button>
        </p>
      </div>
    </div>

    <p class="status" id="status" role="status" aria-live="polite"></p>
  </section>

  <section class="page result" id="result" hidden>
    <div class="summary" id="summary"></div>

    <div class="panel" id="diagnostics-panel" hidden>
      <div class="panel-head">
        <p class="eyebrow">Diagnostics</p>
        <span class="count tnum" id="diag-count"></span>
      </div>
      <ul class="diags" id="diags"></ul>
    </div>

    <div class="panel viewer">
      <div class="panel-head">
        <div class="controls">
          <label class="ctl">
            <span>Window</span>
            <select id="window-length">
              <option value="5">5 s</option>
              <option value="10" selected>10 s</option>
              <option value="30">30 s</option>
              <option value="60">60 s</option>
            </select>
          </label>
          <span class="clock tnum" id="clock"></span>
        </div>
      </div>

      <div class="channels" id="channels"></div>

      <canvas id="scope" aria-label="Waveform display"></canvas>

      <div class="scrub">
        <input type="range" id="position" min="0" max="0" step="0.1" value="0" aria-label="Position in the recording" />
      </div>
    </div>

    <div class="panel" id="events-panel" hidden>
      <div class="panel-head">
        <p class="eyebrow">Events</p>
        <span class="count tnum" id="event-count"></span>
      </div>
      <div class="scroll-x">
        <table class="events">
          <thead>
            <tr>
              <th scope="col">Onset</th>
              <th scope="col">Duration</th>
              <th scope="col">Text</th>
            </tr>
          </thead>
          <tbody id="events"></tbody>
        </table>
      </div>
    </div>

    <div class="panel">
      <div class="scroll-x">
        <table class="fields">
          <thead>
            <tr>
              <th scope="col">#</th>
              <th scope="col">Label</th>
              <th scope="col">Unit</th>
              <th scope="col">Rate</th>
              <th scope="col">Samples/record</th>
              <th scope="col">Physical range</th>
              <th scope="col">Digital range</th>
            </tr>
          </thead>
          <tbody id="fields"></tbody>
        </table>
      </div>
    </div>
  </section>
</Base>

<script>
  import {
    blobSource,
    buildRecordIndex,
    byteSource,
    formatStartTimeNaive,
    isEdfError,
    openEdf,
    readAnnotations,
    readWindow,
    toPhysical,
    type EdfAnnotation,
    type EdfRecording,
    type EdfSignal,
  } from 'edfcore';
  import { animate } from 'motion';
  import { buildSampleEdf } from '../scripts/sample-edf';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const dropzone = $<HTMLDivElement>('dropzone');
  const input = $<HTMLInputElement>('file-input');
  const statusEl = $<HTMLParagraphElement>('status');
  const result = $<HTMLElement>('result');
  const scope = $<HTMLCanvasElement>('scope');
  const position = $<HTMLInputElement>('position');
  const windowLength = $<HTMLSelectElement>('window-length');
  const clock = $<HTMLSpanElement>('clock');

  let recording: EdfRecording | null = null;
  let selected: number[] = [];
  let annotations: readonly EdfAnnotation[] = [];
  let redrawToken = 0;
  let loadGeneration = 0;
  let activeLoad: AbortController | undefined;
  let canDraw = false;

  const ANNOTATION_SCAN_TARGET_BYTES = 4 * 1024 * 1024;

  const fmt = (value: number, digits = 2) =>
    Number.isFinite(value) ? value.toFixed(digits).replace(/\.?0+$/, '') : '—';

  const hhmmss = (seconds: number) => {
    const s = Math.max(0, Math.floor(seconds));
    return [Math.floor(s / 3600), Math.floor((s % 3600) / 60), s % 60]
      .map((n) => String(n).padStart(2, '0'))
      .join(':');
  };

  function setStatus(message: string, kind: 'idle' | 'busy' | 'error' = 'idle') {
    statusEl.textContent = message;
    statusEl.dataset.kind = kind;
  }

  function errorDetail(error: unknown): string {
    if (isEdfError(error)) {
      return `${(error as { code?: string }).code ?? error.edfErrorKind}: ${error.message}`;
    }
    return error instanceof Error ? error.message : String(error);
  }

  function readyMessage(name: string, next: EdfRecording): string {
    const { header, timeline } = next;
    return `${name} — ${header.variant}, ${header.signals.length} signals, ${hhmmss(timeline.spanSeconds)}`;
  }

  function isActiveLoad(generation: number, controller: AbortController): boolean {
    return generation === loadGeneration && !controller.signal.aborted;
  }

  async function scanAnnotations(
    next: EdfRecording,
    name: string,
    generation: number,
    controller: AbortController,
  ): Promise<readonly EdfAnnotation[] | undefined> {
    const { header } = next;
    const recordsPerBatch = Math.max(
      1,
      Math.floor(ANNOTATION_SCAN_TARGET_BYTES / Math.max(1, header.recordByteLength)),
    );
    const found: EdfAnnotation[] = [];
    setStatus(`${name} — reading events 0%`, 'busy');

    for (let start = 0; start < header.recordCount; start += recordsPerBatch) {
      const count = Math.min(recordsPerBatch, header.recordCount - start);
      const batch = await readAnnotations(
        next,
        { start, count },
        { signal: controller.signal },
      );
      if (!isActiveLoad(generation, controller)) return undefined;
      for (const annotation of batch.annotations) found.push(annotation);

      const done = start + count;
      const percent = Math.round((done / header.recordCount) * 100);
      setStatus(`${name} — reading events ${percent}%`, 'busy');
    }

    return Object.freeze(found);
  }

  // ---------------------------------------------------------------- loading

  async function load(bytes: Uint8Array | File, name: string) {
    activeLoad?.abort();
    const controller = new AbortController();
    activeLoad = controller;
    const generation = ++loadGeneration;
    canDraw = false;
    redrawToken += 1;
    result.hidden = true;
    setStatus(`Reading ${name}…`, 'busy');

    try {
      const source = bytes instanceof File ? blobSource(bytes) : byteSource(bytes);
      const opened = await openEdf(source, { signal: controller.signal });
      if (!isActiveLoad(generation, controller)) return;

      let next = opened;
      const header = opened.header;
      selected = header.dataSignalIndices.slice(0, 4);
      annotations = [];
      recording = next;

      renderSummary();
      renderDiagnostics();
      renderFields();
      renderEvents();
      renderChannelPicker();

      const span = opened.timeline.spanSeconds;
      position.max = String(Math.max(0, span - Number(windowLength.value)));
      position.value = '0';

      result.hidden = false;
      resize();
      animate(
        result,
        { opacity: [0, 1], transform: ['translateY(10px)', 'translateY(0px)'] },
        { duration: 0.4 },
      );

      const needsCompleteIndex =
        header.continuity === 'discontinuous' ||
        opened.timeline.spanSeconds !== opened.timeline.coveredSeconds;
      if (needsCompleteIndex) {
        setStatus(`${name} — indexing discontinuities 0%`, 'busy');
        void draw();
        const index = await buildRecordIndex(opened, {
          signal: controller.signal,
          onProgress: (done, total) => {
            if (!isActiveLoad(generation, controller)) return;
            const percent = total === 0 ? 100 : Math.round((done / total) * 100);
            setStatus(`${name} — indexing discontinuities ${percent}%`, 'busy');
          },
        });
        if (!isActiveLoad(generation, controller)) return;
        next = { ...opened, index };
        recording = next;
      }

      canDraw = true;
      setStatus(readyMessage(name, next));
      void draw();

      if (header.annotationSignalIndices.length > 0 && header.recordCount > 0) {
        try {
          const found = await scanAnnotations(next, name, generation, controller);
          if (found === undefined || !isActiveLoad(generation, controller)) return;
          annotations = found;
          renderEvents();
          setStatus(readyMessage(name, next));
          void draw();
        } catch (error) {
          if (!isActiveLoad(generation, controller)) return;
          setStatus(`${readyMessage(name, next)} · events unavailable: ${errorDetail(error)}`, 'error');
        }
      }
    } catch (error) {
      if (!isActiveLoad(generation, controller)) return;
      recording = null;
      annotations = [];
      canDraw = false;
      result.hidden = true;
      // The point of the library is that this message is specific, so show all of it.
      setStatus(errorDetail(error), 'error');
    } finally {
      if (generation === loadGeneration) activeLoad = undefined;
    }
  }

  // ---------------------------------------------------------------- rendering

  function renderSummary() {
    if (!recording) return;
    const { header, timeline } = recording;
    const start = formatStartTimeNaive(header.startTime);
    const rates = [
      ...new Set(
        header.dataSignalIndices
          .map((i) => header.signals[i]?.sampleRateHz)
          .filter((r): r is number => r !== undefined),
      ),
    ].sort((a, b) => a - b);

    const items: Array<[string, string]> = [
      ['Format', header.variant],
      ['Continuity', header.continuity],
      ['Duration', hhmmss(timeline.spanSeconds)],
      ['Data records', `${header.recordCount} × ${fmt(header.recordDurationSeconds, 3)} s`],
      ['Signals', `${header.dataSignalIndices.length} data · ${header.annotationSignalIndices.length} annotation`],
      ['Sample rates', rates.length ? `${rates.map((r) => `${fmt(r)} Hz`).join(', ')}` : '—'],
      ['Start', start ?? 'not stated'],
      ['Bytes/sample', String(header.bytesPerSample)],
    ];

    $<HTMLDivElement>('summary').innerHTML = items
      .map(
        ([label, value]) =>
          `<div class="cell"><span class="k">${label}</span><span class="v">${escapeHtml(value)}</span></div>`,
      )
      .join('');
  }

  function renderDiagnostics() {
    if (!recording) return;
    const list = recording.header.diagnostics;
    const panel = $<HTMLDivElement>('diagnostics-panel');
    panel.hidden = list.length === 0;
    if (list.length === 0) return;

    $<HTMLSpanElement>('diag-count').textContent = `${list.length}`;
    $<HTMLUListElement>('diags').innerHTML = list
      .map(
        (d) => `<li class="diag diag-${d.severity}">
          <span class="sev">${d.severity}</span>
          <code>${escapeHtml(d.code)}</code>
          <span class="msg">${escapeHtml(d.message)}</span>
          ${d.byteOffset !== undefined ? `<span class="at tnum">byte ${d.byteOffset}</span>` : ''}
        </li>`,
      )
      .join('');
  }

  function renderFields() {
    if (!recording) return;
    $<HTMLTableSectionElement>('fields').innerHTML = recording.header.signals
      .map(
        (s: EdfSignal) => `<tr${s.kind === 'annotations' ? ' class="ann"' : ''}>
          <td class="tnum">${s.index}</td>
          <td>${escapeHtml(s.label)}${s.kind === 'annotations' ? '' : ''}</td>
          <td>${escapeHtml(s.physicalDimension.trim() || '—')}</td>
          <td class="tnum">${s.sampleRateHz === undefined ? '—' : `${fmt(s.sampleRateHz)} Hz`}</td>
          <td class="tnum">${s.samplesPerRecord}</td>
          <td class="tnum">${fmt(s.physicalMinimum)} … ${fmt(s.physicalMaximum)}</td>
          <td class="tnum">${s.digitalMinimum} … ${s.digitalMaximum}</td>
        </tr>`,
      )
      .join('');
  }

  function renderEvents() {
    const panel = $<HTMLDivElement>('events-panel');
    panel.hidden = annotations.length === 0;
    if (annotations.length === 0) return;

    $<HTMLSpanElement>('event-count').textContent = `${annotations.length}`;
    $<HTMLTableSectionElement>('events').innerHTML = annotations
      .map(
        (a) => `<tr data-onset="${a.onsetSecondsFromFirstRecord}">
          <td class="tnum">${hhmmss(a.onsetSecondsFromFirstRecord)}</td>
          <td class="tnum">${a.durationSeconds === undefined ? '—' : `${fmt(a.durationSeconds)} s`}</td>
          <td>${escapeHtml(a.text)}</td>
        </tr>`,
      )
      .join('');

    // Clicking an event scrubs to it — the thing anyone actually wants from an event list.
    $<HTMLTableSectionElement>('events')
      .querySelectorAll<HTMLTableRowElement>('tr')
      .forEach((row) => {
        row.addEventListener('click', () => {
          const onset = Number(row.dataset.onset ?? 0);
          position.value = String(Math.max(0, onset - Number(windowLength.value) / 3));
          void draw();
        });
      });
  }

  function renderChannelPicker() {
    if (!recording) return;
    const header = recording.header;
    $<HTMLDivElement>('channels').innerHTML = header.dataSignalIndices
      .map(
        (i) => `<label class="chip">
          <input type="checkbox" value="${i}" ${selected.includes(i) ? 'checked' : ''} />
          <span>${escapeHtml(header.signals[i]?.label ?? `signal ${i}`)}</span>
        </label>`,
      )
      .join('');

    $<HTMLDivElement>('channels')
      .querySelectorAll<HTMLInputElement>('input')
      .forEach((box) => {
        box.addEventListener('change', () => {
          const index = Number(box.value);
          selected = box.checked
            ? [...selected, index].sort((a, b) => a - b)
            : selected.filter((i) => i !== index);
          resize();
          void draw();
        });
      });
  }

  function escapeHtml(value: string): string {
    return value.replace(
      /[&<>"']/g,
      (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] ?? c,
    );
  }

  // ---------------------------------------------------------------- the scope

  const LANE_H = 92;
  /** Reserved strip at the top of the canvas for event labels. */
  const EVENT_BAND = 18;

  function resize() {
    const lanes = Math.max(1, selected.length);
    const cssHeight = EVENT_BAND + lanes * LANE_H + 28;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const width = scope.getBoundingClientRect().width;
    scope.style.height = `${cssHeight}px`;
    scope.width = Math.round(width * dpr);
    scope.height = Math.round(cssHeight * dpr);
    scope.getContext('2d')?.setTransform(dpr, 0, 0, dpr, 0, 0);
  }

  async function draw() {
    const token = ++redrawToken;
    const ctx = scope.getContext('2d');
    if (!ctx || !recording) return;

    const width = scope.getBoundingClientRect().width;
    const height = scope.getBoundingClientRect().height;
    const startSeconds = Number(position.value);
    const durationSeconds = Number(windowLength.value);
    clock.textContent = `${hhmmss(startSeconds)} → ${hhmmss(startSeconds + durationSeconds)}`;

    const s = getComputedStyle(document.documentElement);
    const trace = s.getPropertyValue('--accent').trim();
    const event = s.getPropertyValue('--event').trim();
    const rule = s.getPropertyValue('--rule-soft').trim();
    const muted = s.getPropertyValue('--text-muted').trim();
    const surface = s.getPropertyValue('--bg-sunken').trim();

    ctx.clearRect(0, 0, width, height);
    if (!canDraw) {
      ctx.fillStyle = muted;
      ctx.font = '13px "IBM Plex Mono", monospace';
      ctx.fillText('Indexing the recording timeline…', 12, 28);
      return;
    }
    if (selected.length === 0) {
      ctx.fillStyle = muted;
      ctx.font = '13px "IBM Plex Mono", monospace';
      ctx.fillText('Select at least one channel.', 12, 28);
      return;
    }

    let chunks: Awaited<ReturnType<typeof readWindow>> = [];
    try {
      chunks = await readWindow(recording, {
        signalIndices: selected,
        startSeconds,
        durationSeconds,
      });
    } catch (error) {
      ctx.fillStyle = event;
      ctx.font = '13px "IBM Plex Mono", monospace';
      ctx.fillText(error instanceof Error ? error.message.slice(0, 90) : 'read failed', 12, 28);
      return;
    }
    // A newer scrub started while this read was in flight; its draw wins.
    if (token !== redrawToken) return;

    const secondsToX = (t: number) => ((t - startSeconds) / durationSeconds) * width;

    selected.forEach((signalIndex, lane) => {
      const signal = recording?.header.signals[signalIndex];
      if (!signal) return;
      const top = EVENT_BAND + lane * LANE_H + 14;
      const mid = top + LANE_H / 2 - 7;

      // Baseline and lane divider, kept recessive so the trace owns the ink.
      ctx.strokeStyle = rule;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(0, mid);
      ctx.lineTo(width, mid);
      ctx.stroke();

      // Each lane is direct-labelled, so there is no legend to cross-reference.
      ctx.fillStyle = muted;
      ctx.font = '500 11px "IBM Plex Mono", monospace';
      ctx.fillText(
        `${signal.label}  ${signal.physicalDimension.trim() || 'digital'}`,
        2,
        top - 1,
      );

      for (const chunk of chunks) {
        const part = chunk.signals.find((c) => c.signalIndex === signalIndex);
        if (!part || part.sampleCount === 0) continue;

        let values: ArrayLike<number> = part.digital;
        if (signal.scale !== undefined) {
          try {
            values = toPhysical(signal, part.digital);
          } catch {
            values = part.digital;
          }
        }

        // Scale to the lane from the values on screen, so a flat channel is visibly flat
        // rather than amplified into noise.
        let min = Infinity;
        let max = -Infinity;
        for (let i = 0; i < values.length; i += 1) {
          const v = values[i] as number;
          if (v < min) min = v;
          if (v > max) max = v;
        }
        const spread = Math.max(max - min, 1e-9);
        const amp = (LANE_H - 34) / 2;
        const rate = signal.samplesPerRecord / (recording?.header.recordDurationSeconds || 1);

        ctx.beginPath();
        for (let i = 0; i < values.length; i += 1) {
          const t = part.startSeconds + i / rate;
          const x = secondsToX(t);
          if (x < -4 || x > width + 4) continue;
          const centred = ((values[i] as number) - (min + max) / 2) / spread;
          const y = mid - centred * 2 * amp;
          if (i === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.strokeStyle = trace;
        ctx.lineWidth = 1.6;
        ctx.lineJoin = 'round';
        ctx.stroke();
      }
    });

    // Events sit on top of every lane, in the pen colour reserved for them.
    // Scored events cluster — an apnea and its desaturation land half a second apart — so
    // labels claim a row and the next one drops beneath rather than overprinting.
    const labelRows: number[] = [];
    for (const annotation of annotations) {
      const onset = annotation.onsetSecondsFromFirstRecord;
      if (onset < startSeconds || onset > startSeconds + durationSeconds) continue;
      const x = secondsToX(onset);

      if (annotation.durationSeconds) {
        ctx.fillStyle = event;
        ctx.globalAlpha = 0.09;
        const w = (annotation.durationSeconds / durationSeconds) * width;
        ctx.fillRect(x, 14, w, height - 22);
      }

      ctx.globalAlpha = 0.9;
      ctx.strokeStyle = event;
      ctx.lineWidth = 1.25;
      ctx.setLineDash([3, 3]);
      ctx.beginPath();
      ctx.moveTo(x, 14);
      ctx.lineTo(x, height - 8);
      ctx.stroke();
      ctx.setLineDash([]);

      // Labels ride along the top edge rather than the bottom, where they used to sit on
      // top of the last lane's trace. A chip behind the text keeps it legible over a signal.
      const label = annotation.text.slice(0, 24);
      ctx.font = '500 10px "IBM Plex Mono", monospace';
      const textWidth = ctx.measureText(label).width;
      const chipX = Math.min(x + 3, width - textWidth - 8);

      let row = 0;
      while (row < labelRows.length && chipX < (labelRows[row] ?? 0)) row += 1;
      labelRows[row] = chipX + textWidth + 8;
      const chipY = 1 + row * 13;

      ctx.globalAlpha = 1;
      ctx.fillStyle = surface;
      ctx.fillRect(chipX - 2, chipY, textWidth + 6, 13);
      ctx.fillStyle = event;
      ctx.fillText(label, chipX + 1, chipY + 10);
    }
  }

  // ---------------------------------------------------------------- wiring

  $<HTMLButtonElement>('browse').addEventListener('click', () => input.click());

  $<HTMLButtonElement>('sample').addEventListener('click', () => {
    void load(buildSampleEdf(), 'sample-psg.edf');
  });

  input.addEventListener('change', () => {
    const file = input.files?.[0];
    if (file) void load(file, file.name);
  });

  ['dragenter', 'dragover'].forEach((type) =>
    dropzone.addEventListener(type, (e) => {
      e.preventDefault();
      dropzone.dataset.over = 'true';
    }),
  );
  ['dragleave', 'drop'].forEach((type) =>
    dropzone.addEventListener(type, (e) => {
      e.preventDefault();
      delete dropzone.dataset.over;
    }),
  );
  dropzone.addEventListener('drop', (e) => {
    const file = (e as DragEvent).dataTransfer?.files?.[0];
    if (file) void load(file, file.name);
  });

  position.addEventListener('input', () => void draw());
  windowLength.addEventListener('change', () => {
    if (recording) {
      position.max = String(
        Math.max(0, recording.timeline.spanSeconds - Number(windowLength.value)),
      );
    }
    void draw();
  });

  let frame = 0;
  window.addEventListener('resize', () => {
    cancelAnimationFrame(frame);
    frame = requestAnimationFrame(() => {
      resize();
      void draw();
    });
  });

  new MutationObserver(() => void draw()).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });
</script>

<style>
  .intro {
    padding-block: var(--s-7) var(--s-5);
  }

  .intro h1 {
    margin-top: var(--s-3);
    font-size: clamp(2.1rem, 4.5vw, 3rem);
  }

  .lead {
    margin-top: var(--s-4);
    max-width: 58ch;
    color: var(--text-dim);
    font-size: var(--t-md);
  }

  .dropzone {
    border: 1px dashed var(--rule);
    border-radius: var(--radius-lg);
    background: var(--bg-sunken);
    padding: var(--s-8) var(--s-5);
    text-align: center;
    transition: border-color 150ms ease, background 150ms ease;
  }

  .dropzone[data-over='true'] {
    border-color: var(--accent);
    border-style: solid;
    background: var(--bg-raised);
  }

  .dz-trace {
    width: 56px;
    height: 30px;
    margin: 0 auto var(--s-4);
    color: var(--accent);
  }

  .dz-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-stretch: 110%;
    font-size: var(--t-md);
  }

  .dz-sub {
    margin-top: var(--s-2);
    font-family: var(--font-mono);
    font-size: var(--t-sm);
    color: var(--text-muted);
  }

  .link-btn {
    border: 0;
    background: none;
    padding: 0;
    color: var(--accent);
    font: inherit;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .status {
    margin-top: var(--s-4);
    min-height: 1.5rem;
    font-family: var(--font-mono);
    font-size: var(--t-sm);
    color: var(--text-muted);
  }

  .status[data-kind='error'] {
    color: var(--event);
